# Groq API for LLM inference (Required)
GROQ_API_KEY=your_groq_api_key

# Hugging Face token for WhisperX diarization (Optional: Pyannote diarization)
HF_TOKEN=your_huggingface_token

# Sarvam AI API key for Hinglish translation/STT (Optional)
SARVAM_API_KEY=your_sarvam_api_key

# Model Configurations
WHISPER_MODEL=base
GROQ_MODEL=openai/gpt-oss-20b
SARVAM_STT_MODEL=saaras:v2.5
